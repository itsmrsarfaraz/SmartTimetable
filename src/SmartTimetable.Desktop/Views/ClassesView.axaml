<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartTimetable.Desktop.Views.ClassesView"
             x:CompileBindings="False">

    <Grid Margin="32" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Description}" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,420">

            <!-- Class list -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="90" />
                        <DataGridTextColumn Header="Grade" Binding="{Binding GradeLevel}" Width="70" />
                        <DataGridTextColumn Header="Program" Binding="{Binding Program.Name}" Width="160" />
                        <DataGridTextColumn Header="Students" Binding="{Binding StudentCount}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Editor + demand -->
            <Border Grid.Column="1" Classes="card">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding FormTitle}" Classes="h2" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="Class name" />
                            <TextBox Text="{Binding Name}" Watermark="e.g. Grade 9 or ICS Part 1" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="6" Width="120">
                                <TextBlock Text="Section" />
                                <TextBox Text="{Binding Section}" Watermark="A" />
                            </StackPanel>
                            <StackPanel Spacing="6" Width="110">
                                <TextBlock Text="Grade level" />
                                <NumericUpDown Value="{Binding GradeLevel}" Minimum="0" Maximum="14" Increment="1" FormatString="0" />
                            </StackPanel>
                            <StackPanel Spacing="6" Width="110">
                                <TextBlock Text="Students" />
                                <NumericUpDown Value="{Binding StudentCount}" Minimum="1" Maximum="200" Increment="1" FormatString="0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Program" />
                            <ComboBox ItemsSource="{Binding Programs}"
                                      SelectedItem="{Binding SelectedProgram}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Home room" />
                            <ComboBox ItemsSource="{Binding Rooms}"
                                      SelectedItem="{Binding SelectedHomeRoom}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Content="Save class" Classes="primary" Command="{Binding SaveClassCommand}" />
                            <Button Content="New" Classes="ghost" Command="{Binding NewCommand}" />
                            <Button Content="Delete" Classes="danger" Command="{Binding DeleteClassCommand}" />
                        </StackPanel>

                        <Border Classes="banner" Classes.error="{Binding StatusIsError}"
                                IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        </Border>

                        <Separator Background="#E2E8F0" Margin="0,6" />

                        <TextBlock Text="Weekly subjects" Classes="h2" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Add each subject this class studies and how many periods per week it needs. Pin a teacher, or leave it to the solver." />

                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" MaxHeight="220">
                            <DataGrid ItemsSource="{Binding Demands}"
                                      SelectedItem="{Binding SelectedDemand}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject.Name}" Width="*" />
                                    <DataGridTextColumn Header="Periods/wk" Binding="{Binding PeriodsPerWeek}" Width="90" />
                                    <DataGridTextColumn Header="Teacher" Binding="{Binding PreferredTeacher.FullName}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <TextBlock Classes="muted" TextWrapping="Wrap" FontStyle="Italic"
                                   IsVisible="{Binding !CanEditDemands}"
                                   Text="Save the class above first — then this section unlocks so you can add its weekly subjects and assign teachers." />

                        <StackPanel Spacing="12" IsEnabled="{Binding CanEditDemands}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Subject" />
                                <ComboBox ItemsSource="{Binding Subjects}"
                                          SelectedItem="{Binding DemandSubject}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Periods / week" />
                                    <NumericUpDown Value="{Binding DemandPeriods}" Minimum="1" Maximum="40" Increment="1" FormatString="0" />
                                </StackPanel>
                                <StackPanel Spacing="6" Width="230">
                                    <TextBlock Text="Preferred teacher" />
                                    <ComboBox ItemsSource="{Binding Teachers}"
                                              SelectedItem="{Binding DemandTeacher}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Add / update subject" Classes="primary" Command="{Binding AddDemandCommand}" />
                                <Button Content="Remove selected" Classes="ghost" Command="{Binding RemoveDemandCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="banner" Classes.error="{Binding DemandStatusIsError}"
                                IsVisible="{Binding DemandStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding DemandStatus}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</UserControl>
