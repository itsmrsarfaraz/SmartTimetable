<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="SmartTimetable.Desktop.Views.SubjectsView"
             x:CompileBindings="False">

    <Grid Margin="32" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Description}" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,360">

            <!-- List -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120" />
                        <DataGridCheckBoxColumn Header="Lab" Binding="{Binding IsLabSubject}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding FormTitle}" Classes="h2" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" />
                        <TextBox Text="{Binding Name}" Watermark="e.g. Mathematics" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Code" />
                        <TextBox Text="{Binding Code}" Watermark="e.g. MATH" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsLabSubject}" Content="Requires a laboratory" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                        <Button Content="New" Classes="ghost" Command="{Binding NewCommand}" />
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
