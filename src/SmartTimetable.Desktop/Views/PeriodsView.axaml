<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartTimetable.Desktop.Views.PeriodsView"
             x:CompileBindings="False">

    <Grid Margin="32" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Description}" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,360">

            <Border Grid.Column="0" Classes="card" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="50" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="90" />
                        <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="90" />
                        <DataGridCheckBoxColumn Header="Break" Binding="{Binding IsBreak}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding FormTitle}" Classes="h2" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Order (position in the day)" />
                        <NumericUpDown Value="{Binding Order}" Minimum="1" Maximum="30" Increment="1" FormatString="0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" />
                        <TextBox Text="{Binding Name}" Watermark="e.g. Period 1 or Break" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="6" Width="140">
                            <TextBlock Text="Start (HH:mm)" />
                            <TextBox Text="{Binding StartText}" Watermark="08:00" />
                        </StackPanel>
                        <StackPanel Spacing="6" Width="140">
                            <TextBlock Text="End (HH:mm)" />
                            <TextBox Text="{Binding EndText}" Watermark="08:45" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding IsBreak}" Content="This is a break (no lessons)" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                        <Button Content="New" Classes="ghost" Command="{Binding NewCommand}" />
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
