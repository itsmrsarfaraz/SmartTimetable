<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartTimetable.Desktop.Views.RoomsView"
             x:CompileBindings="False">

    <Grid Margin="32" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Description}" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,360">

            <Border Grid.Column="0" Classes="card" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                        <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="90" />
                        <DataGridTextColumn Header="Building" Binding="{Binding Building}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding FormTitle}" Classes="h2" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Name" />
                        <TextBox Text="{Binding Name}" Watermark="e.g. Room 12" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Type" />
                        <ComboBox ItemsSource="{Binding RoomTypes}"
                                  SelectedItem="{Binding Type}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Capacity" />
                        <NumericUpDown Value="{Binding Capacity}" Minimum="1" Maximum="1000" Increment="1" FormatString="0" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Building" />
                        <TextBox Text="{Binding Building}" Watermark="e.g. Main Block" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                        <Button Content="New" Classes="ghost" Command="{Binding NewCommand}" />
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
