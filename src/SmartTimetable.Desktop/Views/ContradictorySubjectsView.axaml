<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             x:Class="SmartTimetable.Desktop.Views.ContradictorySubjectsView"
             x:CompileBindings="False">

    <Grid Margin="32" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Classes="h1" />
            <TextBlock Text="{Binding Description}" Classes="muted" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,380">

            <!-- List -->
            <Border Grid.Column="0" Classes="card" Margin="0,0,20,0" Padding="0">
                <DataGrid ItemsSource="{Binding Rules}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject.Name}" Width="*" />
                        <DataGridTextColumn Header="Blocked in program" Binding="{Binding Program.Name}" Width="*" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding FormTitle}" Classes="h2" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Subject" />
                        <ComboBox ItemsSource="{Binding Subjects}"
                                  SelectedItem="{Binding SelectedSubject}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Blocked in program" />
                        <ComboBox ItemsSource="{Binding Programs}"
                                  SelectedItem="{Binding SelectedProgram}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Reason (optional)" />
                        <TextBox Text="{Binding Reason}"
                                 Watermark="e.g. Not part of the Pre-Medical scheme"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" />
                        <Button Content="New" Classes="ghost" Command="{Binding NewCommand}" />
                        <Button Content="Delete" Classes="danger" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <Border Classes="banner" Classes.error="{Binding StatusIsError}"
                            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Classes="muted" TextWrapping="Wrap"
                               Text="Blocking a subject removes it from every class in that program the next time you generate — nothing is deleted from your data." />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
